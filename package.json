{
  "name": "starter-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@mfeflow/oxlint-config": "^0.8.0",
    "@mfeflow/tsconfig": "^0.8.0",
    "@playwright/test": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "mfeflow": "^0.8.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "doctor": "mfeflow doctor",
    "validate": "mfeflow validate",
    "check-compat": "mfeflow check-compat",
    "budget": "mfeflow budget",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:runtime-config": "node --experimental-strip-types scripts/check-runtime-config.ts",
    "typecheck:tooling": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "lefthook install"
  }
}
